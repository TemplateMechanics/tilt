{
  "_comment": [
    "Services to validate in a browser, and where their real UI lives.",
    "",
    "`path` matters: several services 404 on / while working perfectly on their",
    "actual entry point. tilt-config-server is the example \u2014 / returns",
    "{\"error\":\"Not found\"} and /config returns 200. Checking / and calling it a",
    "failure would have sent someone hunting a routing bug that does not exist.",
    "",
    "`expect` is a case-insensitive substring that must appear in the rendered",
    "page text. A 200 with an empty shell is the failure this whole harness is",
    "for, so asserting on content is the point, not a nicety.",
    "",
    "`configKey` is the tilt-config.json flag that enables the service, so a run",
    "can report 'not enabled' distinctly from 'enabled and broken'."
  ],
  "services": [
    {
      "name": "airflow",
      "host": "airflow.localhost",
      "path": "/",
      "expect": "Airflow",
      "configKey": "raw_apps.airflow"
    },
    {
      "name": "argo-workflows",
      "host": "argo.localhost",
      "path": "/",
      "expect": "Argo",
      "configKey": "flux_apps.argo-workflows"
    },
    {
      "name": "argocd",
      "host": "argocd.localhost",
      "path": "/",
      "expect": "Argo CD",
      "configKey": "flux_apps.argocd"
    },
    {
      "name": "backstage",
      "host": "backstage.localhost",
      "path": "/",
      "expect": "Backstage",
      "configKey": "raw_apps.backstage",
      "note": "Image is built from source in-cluster; allow 20+ minutes cold."
    },
    {
      "name": "dapr",
      "host": "dapr.localhost",
      "path": "/",
      "expect": "Dapr",
      "configKey": "flux_apps.dapr"
    },
    {
      "name": "grafana",
      "host": "grafana.localhost",
      "path": "/login",
      "expect": "Welcome to Grafana",
      "configKey": null,
      "note": "Always-on observability stack."
    },
    {
      "name": "harbor",
      "host": "harbor.localhost",
      "path": "/",
      "expect": "Harbor",
      "configKey": "crossplane_apps.harbor"
    },
    {
      "name": "jenkins",
      "host": "jenkins.localhost",
      "path": "/",
      "expect": "Jenkins",
      "configKey": "crossplane_apps.jenkins"
    },
    {
      "name": "jupyterhub",
      "host": "jupyterhub.localhost",
      "path": "/",
      "expect": "Jupyter",
      "configKey": "raw_apps.jupyterhub"
    },
    {
      "name": "keycloak",
      "host": "auth.localhost",
      "path": "/",
      "expect": "Keycloak",
      "configKey": "raw_apps.keycloak",
      "note": "Route host is auth.localhost, not keycloak.localhost."
    },
    {
      "name": "langfuse",
      "host": "langfuse.localhost",
      "path": "/",
      "expect": "Langfuse",
      "configKey": "crossplane_apps.langfuse"
    },
    {
      "name": "localstack",
      "host": "localstack.localhost",
      "path": "/_localstack/health",
      "expect": "services",
      "configKey": "crossplane_apps.localstack"
    },
    {
      "name": "mailhog",
      "host": "mailhog.localhost",
      "path": "/",
      "expect": "MailHog",
      "configKey": "raw_apps.mailhog",
      "note": "The /api/v2/jim 404 is MailHog's optional chaos monkey, not a fault."
    },
    {
      "name": "ollama",
      "host": "ollama.localhost",
      "path": "/",
      "expect": "Ollama",
      "configKey": "flux_apps.ollama"
    },
    {
      "name": "opencost",
      "host": "opencost.localhost",
      "path": "/",
      "expect": "Cost Allocation",
      "configKey": "flux_apps.opencost",
      "note": "Expect the page heading, not the product name: 'OpenCost' appears only in the logo image and the version footer, outside the text sample."
    },
    {
      "name": "qdrant",
      "host": "qdrant.localhost",
      "path": "/dashboard",
      "expect": "Qdrant",
      "configKey": "crossplane_apps.qdrant"
    },
    {
      "name": "rabbitmq",
      "host": "rabbitmq.localhost",
      "path": "/",
      "expect": "RabbitMQ",
      "configKey": "raw_apps.rabbitmq"
    },
    {
      "name": "thanos",
      "host": "thanos.localhost",
      "path": "/",
      "expect": "Thanos",
      "configKey": "flux_apps.thanos"
    },
    {
      "name": "tilt-config-server",
      "host": "tilt-config.localhost",
      "path": "/config",
      "expect": "crossplane_apps",
      "configKey": null,
      "note": "Serves JSON, not HTML. / has no handler and returns 404 by design."
    },
    {
      "name": "wazuh",
      "host": "wazuh.localhost",
      "path": "/",
      "expect": "Wazuh",
      "configKey": "raw_apps.wazuh"
    },
    {
      "name": "wordpress",
      "host": "wordpress.localhost",
      "path": "/",
      "expect": "WordPress",
      "configKey": "raw_apps.wordpress"
    }
  ]
}
