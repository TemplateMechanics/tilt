###############################################################################
# CORE  (profile: minimal and above)
#
# The smallest platform that serves an app over HTTPS in the mesh: Flux,
# Gateway API, Istio ambient, cert-manager + PKI, the Gateway, OS trust of the
# CA, and hello-world. Nothing here is optional — remove any one and either
# nothing routes, nothing has a certificate, or nothing trusts it.
###############################################################################

load("./lib.tilt", "sh", "get_os_type", "k8s_namespace", "k8s_kustomize_simple", "CONFIG", "PLATFORM", "GATEWAY_API_VERSION", "FLUX_VERSION", "WAIT_HR", "ROOT")

###############################################################################
# INFRASTRUCTURE (Always On)
###############################################################################

# Required namespaces
k8s_namespace("flux")
k8s_namespace("monitoring")
k8s_namespace("logging")
k8s_namespace("tracing")

# Flux GitOps
local_resource(
    "flux-install",
    cmd=sh("""
        # The CLI is what is pinned, not `flux install --version`. A CLI only
        # installs its own minor version: v2.10.0 refuses --version=v2.9.5
        # ("targeted version 'v2.9.5' is not compatible with your current
        # version of flux (2.10.0)"), and on Windows even v2.9.5 asked for
        # v2.9.0 fails ("CreateFile ... flux-system.yaml: The specified path is
        # invalid"). So the platform
        # needs this exact CLI and runs a bare `flux install`, which uses the
        # manifests built into it.
        want=""" + FLUX_VERSION + """
        if ! command -v flux >/dev/null 2>&1; then
            echo "Flux CLI not found - installing $want..."
            # No brew branch: fluxcd/tap only carries the latest release.
            if command -v choco >/dev/null 2>&1; then
                choco install flux --version="${want#v}" -y
            elif command -v curl >/dev/null 2>&1; then
                curl -s https://fluxcd.io/install.sh | FLUX_VERSION="${want#v}" bash
            else
                echo "ERROR: Cannot install Flux CLI $want. Install it manually:"
                echo "  https://fluxcd.io/flux/installation/#install-the-flux-cli"
                exit 1
            fi
        fi
        have=$(flux version --client 2>/dev/null | sed -n 's/^flux: *//p')
        if [ "$have" != "$want" ]; then
            echo "ERROR: Flux CLI is ${have:-unknown}; this platform pins $want (FLUX_VERSION in tilt/lib.tilt)."
            echo "  The flux on your PATH: $(command -v flux)"
            echo "  Windows:      choco upgrade flux --version=${want#v} --allow-downgrade -y"
            echo "  macOS/Linux:  curl -s https://fluxcd.io/install.sh | sudo FLUX_VERSION=${want#v} bash"
            # Homebrew's flux sits earlier on PATH than install.sh's /usr/local/bin,
            # so installing the pinned one alone leaves this error in place.
            echo "  If that path is Homebrew's: brew uninstall flux, then the line above"
            exit 1
        fi

        # Each step stops the resource on failure. sh() runs bash without set -e, so
        # these used to fall through: with flux install failing and every wait timing
        # out, this printed "All Flux controllers ready" and went green, and the
        # failure surfaced later, somewhere else, as a HelmRepository that never synced.
        echo "Installing / upgrading Flux $want on cluster..."
        flux install || { echo "ERROR: flux install failed (output above)"; exit 1; }

        echo "Waiting for all Flux controllers to be ready..."
        for d in source-controller helm-controller kustomize-controller notification-controller; do
            kubectl -n flux-system wait --for=condition=available deployment/$d --timeout=120s || {
                echo "ERROR: $d did not become available in 120s"
                kubectl -n flux-system get pods
                exit 1
            }
        done
        echo "✓ All Flux controllers ready"

        # Check, never rewrite. This used to detect the cluster's Flux API
        # versions and sed every HelmRelease and HelmRepository under helm/ to
        # match. With the CLI pinned it could only rewrite files to what they
        # already said, and it still rewrote all 71 on every run. Each write
        # trips the deps of every resource watching helm/: on a cluster built
        # from empty, the second flux-install run (finished 02:34:18) was
        # followed from 02:35:33 by cert-manager, cloudnative-pg,
        # external-secrets, flagger, istio, kiali, metrics-server and
        # helm-repositories each re-running, about four minutes of work. On
        # Windows the rewrite also changed line endings, so git status showed
        # 71 modified files nobody had edited.
        # Read once, and separately from the check: an unreachable cluster used to be
        # reported as "does not serve", sending people after the wrong problem.
        apis=$(kubectl api-versions) || { echo "ERROR: could not reach the cluster to list its API versions"; exit 1; }
        for api in helm.toolkit.fluxcd.io/v2 source.toolkit.fluxcd.io/v1; do
            printf '%s\n' "$apis" | grep -qx "$api" || {
                echo "ERROR: the cluster does not serve $api, which every HelmRelease/HelmRepository in helm/ uses"
                exit 1
            }
        done
        echo "✓ Flux serves helm.toolkit.fluxcd.io/v2 and source.toolkit.fluxcd.io/v1"
    """),
    labels=["Infrastructure"]
)


###############################################################################
# OBSERVABILITY STACK (Always On)
###############################################################################

# Apply and wait for HelmRepositories to be ready
# NOTE: We do NOT call k8s_yaml(kustomize(ROOT + "/helm/repositories/")) at load time
# because Flux CRDs (HelmRepository) may not exist yet on a fresh cluster.
# Instead, helm-repositories applies them at runtime after flux-install completes.
local_resource(
    "helm-repositories",
    cmd=sh("""
        # Check exactly the repositories this resource applies, by NAME, taken
        # from the rendered kustomization. Two earlier versions got the count
        # wrong in opposite directions: grepping helm/repositories/ gave 23 while
        # the cluster had 29 (six components ship their own HelmRepository beside
        # their HelmRelease, applied by other resources), and grepping all of
        # helm/ gave 69 because it counted mentions in comments and dashboard
        # JSON. Names from the rendered output are exact, and this resource has
        # no business counting repositories it did not apply.
        . ./scripts/lib/python.sh
        NAMES=$(kubectl kustomize ./helm/repositories/ | "$PY" -c "import sys,yaml; print(' '.join(d['metadata']['name'] for d in yaml.safe_load_all(sys.stdin) if d and d.get('kind')=='HelmRepository'))")
        # Empty means nothing was read (no Python, no PyYAML, a broken kustomize),
        # not that there's nothing to check: with 0 expected, every check below passed.
        [ -n "$NAMES" ] || { echo "ERROR: could not read the HelmRepository names from helm/repositories/ (is python3 with PyYAML installed?)"; exit 1; }
        EXPECTED=$(echo $NAMES | wc -w | tr -d ' ')
        echo "Applying $EXPECTED HelmRepositories from helm/repositories/ (will retry until all exist)..."
        # Success needs a clean apply as well as every name existing. Checking
        # names alone passed an edit that failed to apply to a repository that
        # already existed: the old object was still there, so nothing looked
        # missing. The apply may fail while Flux's CRDs settle, hence the retry.
        for i in $(seq 1 30); do
            APPLIED=yes
            kubectl apply -k ./helm/repositories/ 2>&1 || APPLIED=no
            sleep 3
            MISSING=""
            for n in $NAMES; do kubectl get helmrepository "$n" -n flux-system >/dev/null 2>&1 || MISSING="$MISSING $n"; done
            if [ -z "$MISSING" ] && [ "$APPLIED" = yes ]; then
                echo "✓ $EXPECTED/$EXPECTED HelmRepositories from helm/repositories/ exist ($(kubectl get helmrepository -n flux-system --no-headers 2>/dev/null | wc -l | tr -d ' ') on the cluster in total)"
                exit 0
            fi
            echo "  Attempt $i/30: apply succeeded: $APPLIED; still missing:${MISSING:- none}"
        done
        echo "Timeout after 30 attempts. Last apply succeeded: $APPLIED; still missing:${MISSING:- none}"; exit 1
    """),
    # Without deps a local_resource runs once at `tilt up` and never again, so
    # an edit here reached only clusters started after it while Tilt stayed
    # green (Tilt's docs: "a local resource without deps runs only once").
    # ROOT, not "./": deps resolve relative to this file.
    deps=[ROOT + "/helm/repositories"],
    labels=["Platform"],
    resource_deps=["flux-install"]
)

###############################################################################
# INGRESS: Istio ambient mesh + Gateway API
#
# Replaces Traefik, which is archived under archive/traefik/ (still supported for
# customers running it — see archive/README.md).
#
# The layers below MUST run in this order. Each one installs CRDs that the next
# one creates instances of, so on a fresh cluster an out-of-order apply fails
# with 'no matches for kind "Gateway"' / '"ClusterIssuer"' / '"Certificate"'.
# That failure is transient under Flux retry, which is exactly what makes it
# easy to misread as a flake instead of an ordering bug.
#
#   gateway-api-crds  Gateway/HTTPRoute kinds
#   istio             istio-base -> istiod -> cni -> ztunnel (ambient)
#   cert-manager      the controller (CRDs come with the chart)
#   cert-manager-pki  ClusterIssuers + root/intermediate CA Certificates
#   istio-gateway     the Gateway + the wildcard Certificate it serves
#   local-ca-crls     issuer-signed CRLs on the Gateway's HTTP listener
#   dev-ca-trust      export the root CA and install it in the OS trust store
###############################################################################


local_resource(
    "gateway-api-crds",
    cmd=sh("""
        echo "Installing Gateway API """ + GATEWAY_API_VERSION + """ (standard channel)..."
        kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/""" + GATEWAY_API_VERSION + """/standard-install.yaml
        kubectl wait --for=condition=established --timeout=90s \
            crd/gateways.gateway.networking.k8s.io \
            crd/httproutes.gateway.networking.k8s.io
        echo "Gateway API CRDs established"
    """),
    labels=["Infrastructure"],
)

local_resource(
    "istio",
    cmd=sh(WAIT_HR + """
        kubectl apply -k ./helm/istio/overlays/""" + PLATFORM + """
        wait_hr istio-system istio-base
        wait_hr istio-system istiod
        wait_hr istio-system istio-cni
        wait_hr istio-system ztunnel

        # Ambient capture depends on /run being rshared on every node. If it is
        # not, istio-cni cannot enter pod netns: pods run, ztunnel runs, and
        # nothing is actually in the mesh. Checked here because every component
        # reports healthy in that state.
        kubectl -n istio-system rollout status daemonset/ztunnel --timeout=180s
        kubectl -n istio-system rollout status daemonset/istio-cni-node --timeout=180s

        kubectl get gatewayclass istio -o name >/dev/null 2>&1 \
            && echo "istio GatewayClass registered" \
            || { echo "ERROR: istio GatewayClass missing - Gateway resources would be accepted and never programmed"; exit 1; }
    """),
    # Without deps this ran once at `tilt up` and never again (see
    # helm-repositories). base and overlays only: the gateway/ subfolder has
    # its own resource, and watching it here would re-run all of Istio on
    # every Gateway edit.
    deps=[ROOT + "/helm/istio/base", ROOT + "/helm/istio/overlays"],
    labels=["Infrastructure"],
    resource_deps=["flux-install", "gateway-api-crds", "helm-repositories"],
)

local_resource(
    "cert-manager",
    cmd=sh(WAIT_HR + """
        kubectl apply -k ./helm/cert-manager/overlays/""" + PLATFORM + """
        wait_hr cert-manager cert-manager 420s
        kubectl -n cert-manager rollout status deployment/cert-manager-webhook --timeout=180s
        echo "cert-manager ready"
    """),
    # Without deps this ran once at `tilt up` and never again (see
    # helm-repositories). base and overlays only: pki/ and crl/ have their own
    # resources.
    deps=[ROOT + "/helm/cert-manager/base", ROOT + "/helm/cert-manager/overlays"],
    labels=["Infrastructure"],
    resource_deps=["flux-install", "helm-repositories"],
)

local_resource(
    "cert-manager-pki",
    cmd=sh("""
        ./scripts/apply-local-pki.sh
    """),
    deps=[ROOT + "/helm/cert-manager/pki", ROOT + "/scripts/apply-local-pki.sh"],
    labels=["Infrastructure"],
    resource_deps=["cert-manager"],
)

local_resource(
    "istio-gateway",
    cmd=sh("""
        kubectl apply -k ./helm/istio/gateway/overlays/""" + PLATFORM + """
        kubectl -n istio-system wait --for=condition=Ready certificate/wildcard-localhost --timeout=180s
        kubectl -n istio-system wait --for=condition=Programmed gateway/localhost-gateway --timeout=180s
        kubectl -n istio-system get gateway localhost-gateway
        echo "Gateway programmed and serving the wildcard certificate"
    """),
    # Without deps a local_resource runs once and never again, so edits to
    # the gateway, the certificate SANs or the HTTPS redirect never reached
    # the cluster while Tilt stayed green. Found when https-redirect differed
    # live from the repo. ROOT, not "./": deps resolve relative to this file.
    deps=[ROOT + "/helm/istio/gateway"],
    labels=["Infrastructure"],
    resource_deps=["istio", "cert-manager-pki"],
)

local_resource(
    "local-ca-crls",
    cmd=sh("""
        ./scripts/ensure-local-crls.sh
    """),
    deps=[ROOT + "/helm/cert-manager/crl", ROOT + "/scripts/ensure-local-crls.sh"],
    labels=["Infrastructure"],
    resource_deps=["istio-gateway"],
)

local_resource(
    "hello-world",
    cmd=sh("""
        kubectl apply -k ./examples/hello-world
        kubectl -n hello rollout status deploy/hello --timeout=180s
        # Accepted alone is not "routed": a route whose backendRef names a
        # Service that does not exist is still Accepted, with ResolvedRefs
        # False, and requests to it fail (Gateway API route status). Both must
        # be True. The controller writes status after the apply, so give it
        # up to 30s rather than reading once.
        for i in $(seq 1 30); do
            A=$(kubectl -n hello get httproute hello -o jsonpath='{.status.parents[0].conditions[?(@.type=="Accepted")].status}' 2>/dev/null)
            R=$(kubectl -n hello get httproute hello -o jsonpath='{.status.parents[0].conditions[?(@.type=="ResolvedRefs")].status}' 2>/dev/null)
            [ "$A" = True ] && [ "$R" = True ] && { echo "hello.localhost is routed (Accepted and ResolvedRefs)"; exit 0; }
            sleep 1
        done
        echo "ERROR: HTTPRoute not fully routed - Accepted=${A:-none}, ResolvedRefs=${R:-none}"
        kubectl -n hello describe httproute hello
        exit 1
    """),
    # Re-apply on edit, for the same reason as istio-gateway above. Lab 02
    # has students edit httproute.yaml, and this is what applies it.
    deps=[ROOT + "/examples/hello-world"],
    labels=["Apps"],
    links=["https://hello.localhost"],
    resource_deps=["istio-gateway"],
)

local_resource(
    "dev-ca-trust",
    cmd=sh("""
        ./scripts/trust-ca.sh
    """),
    deps=[ROOT + "/scripts/trust-ca.sh"],
    labels=["Infrastructure"],
    resource_deps=["hello-world", "local-ca-crls"],
)

# Browser-friendly first stop for every hands-on learner, including minimal.
local_resource(
    "bookmarks",
    cmd=sh("""
        set -e
        kubectl apply -k ./helm/bookmarks/
        kubectl -n bookmarks rollout status deployment/bookmarks --timeout=180s
        # Accepted alone can hide a nonexistent backend Service.
        for i in $(seq 1 30); do
            A=$(kubectl -n bookmarks get httproute bookmarks -o jsonpath='{.status.parents[0].conditions[?(@.type=="Accepted")].status}' 2>/dev/null || true)
            R=$(kubectl -n bookmarks get httproute bookmarks -o jsonpath='{.status.parents[0].conditions[?(@.type=="ResolvedRefs")].status}' 2>/dev/null || true)
            [ "$A" = True ] && [ "$R" = True ] && { echo "bookmarks.localhost is routed"; exit 0; }
            sleep 1
        done
        echo "ERROR: Bookmarks route unresolved - Accepted=${A:-none}, ResolvedRefs=${R:-none}" >&2
        exit 1
    """),
    deps=[ROOT + "/helm/bookmarks"],
    labels=["Developer-Portal"],
    links=["https://bookmarks.localhost"],
    resource_deps=["istio-gateway"],
)
